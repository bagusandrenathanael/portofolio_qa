# Prisma CLI uses a local SQLite file only to generate migrations.
LOCAL_DATABASE_URL="file:./dev.db"
# The application and db:deploy use the remote Turso database.
TURSO_DATABASE_URL="libsql://YOUR_DATABASE.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"
